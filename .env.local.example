# Neon コンソール (Connect) から取得した接続文字列を設定してください
# このファイルを .env.local にコピーして使用します
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Google AI Studio (https://aistudio.google.com/apikey) で取得した Gemini API キーを設定してください
GEMINI_API_KEY="your_gemini_api_key_here"

# ローカルの Ollama サーバー (OpenAI 互換 API) を併用する場合のベース URL とモデル名
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# ローカルの XeStrata サーバー (OpenAI 互換 API) を併用する場合のベース URL
XESTRATA_BASE_URL="http://127.0.0.1:8080"

# Google Apps Script ウェブアプリ連携用 URL (gas/Code.gs をデプロイして取得)
GAS_WEBHOOK_URL=""
